# PayPal Sandbox (get from developer.paypal.com → My Apps & Credentials)
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
PAYPAL_MODE=sandbox

# AI Agent (optional — set for real Claude AI analysis, leave blank for rule-based engine)
ANTHROPIC_API_KEY=your_anthropic_key

# Notifications — Email (optional — leave blank to disable)
EMAIL_FROM=your_gmail@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password
EMAIL_TO=recipient@example.com

# Notifications — Discord (optional)
DISCORD_WEBHOOK_URL=your_discord_webhook_url

# Notifications — WhatsApp via Twilio (optional)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_NOTIFY_NUMBER=+254700000000

# Leave blank for sandbox mode — system works fully without real keys
