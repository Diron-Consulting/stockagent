# PayPal Sandbox (get from developer.paypal.com → My Apps & Credentials)
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
PAYPAL_MODE=sandbox

# AI Agent (optional — set for real Claude AI analysis, leave blank for rule-based mock)
ANTHROPIC_API_KEY=your_anthropic_key

# Leave blank for MOCK mode — system works fully without real keys
